rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS & TENANT SECURITY ENFORCEMENT
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserEmail() {
      return isAuthenticated() && request.auth.token.email != null
          ? request.auth.token.email.lower()
          : '';
    }

    function isPlatformMasterAdmin() {
      return isAuthenticated() && (
        currentUserEmail() == 'hossansajjad1994@gmail.com' ||
        (request.auth.token.keys().hasAny(['master_admin']) && request.auth.token.master_admin == true) ||
        exists(/databases/$(database)/documents/platform_super_admins/$(request.auth.uid))
      );
    }

    function getSociety(societyId) {
      return get(/databases/$(database)/documents/somitis/$(societyId)).data;
    }

    function isSocietyCreator(societyId) {
      let somiti = getSociety(societyId);
      return isAuthenticated() && (
        somiti.creatorId == request.auth.uid ||
        (somiti.creatorEmail != null && somiti.creatorEmail.lower() == currentUserEmail())
      );
    }

    function isSocietyMember(societyId) {
      let somiti = getSociety(societyId);
      return isAuthenticated() && (
        isSocietyCreator(societyId) ||
        isPlatformMasterAdmin() ||
        (somiti.assignedMemberEmails != null && somiti.assignedMemberEmails.hasAny([currentUserEmail()]))
      );
    }

    function isSocietyAdmin(societyId) {
      return isAuthenticated() && (
        isPlatformMasterAdmin() ||
        isSocietyCreator(societyId) ||
        exists(/databases/$(database)/documents/somitis/$(societyId)/admins/$(request.auth.uid))
      );
    }

    // ============================================================================
    // GLOBAL FEATURE REGISTRY & MASTER ADMIN CONTROLS
    // ============================================================================

    match /feature_definitions/{featureId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformMasterAdmin();
    }

    match /platform_feature_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformMasterAdmin();
    }

    match /platform_super_admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformMasterAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isPlatformMasterAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    match /user_requests/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isPlatformMasterAdmin() || isAuthenticated();
      allow delete: if isPlatformMasterAdmin();
    }

    // ============================================================================
    // MULTI-SOCIETY / SOMITIS COLLECTIONS
    // ============================================================================

    match /somitis/{somitiId} {
      // Anyone authenticated can read societies they are assigned to, or Master Admin
      allow read: if isAuthenticated() && (
        isPlatformMasterAdmin() ||
        resource.data.creatorId == request.auth.uid ||
        (resource.data.creatorEmail != null && resource.data.creatorEmail.lower() == currentUserEmail()) ||
        (resource.data.assignedMemberEmails != null && resource.data.assignedMemberEmails.hasAny([currentUserEmail()]))
      );

      // Only Master Admin or authenticated users can create new societies
      allow create: if isAuthenticated() && (
        request.resource.data.creatorId == request.auth.uid || isPlatformMasterAdmin()
      );

      // Only Society Creator, Society Admin or Master Admin can update/delete
      allow update: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      allow delete: if isPlatformMasterAdmin() || isSocietyCreator(somitiId);

      // Society-specific feature settings
      match /society_feature_settings/{featureId} {
        allow read: if isSocietyMember(somitiId);
        allow write: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      }

      // Role permission configurations
      match /roles/{roleId} {
        allow read: if isSocietyMember(somitiId);
        allow write: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      }

      // Members subcollection
      match /members/{memberId} {
        allow read: if isSocietyMember(somitiId);
        allow create, update: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
        allow delete: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      }

      // Savings deposits subcollection
      match /deposits/{depositId} {
        allow read: if isSocietyMember(somitiId);
        allow create: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
        allow update, delete: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      }

      // Savings products subcollection
      match /savings_products/{productId} {
        allow read: if isSocietyMember(somitiId);
        allow write: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      }

      // Savings accounts subcollection
      match /savings_accounts/{accountId} {
        allow read: if isSocietyMember(somitiId);
        allow write: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      }

      // Loans subcollection
      match /loans/{loanId} {
        allow read: if isSocietyMember(somitiId);
        allow write: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();

        match /installments/{installmentId} {
          allow read: if isSocietyMember(somitiId);
          allow write: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
        }

        match /transactions/{txId} {
          allow read: if isSocietyMember(somitiId);
          allow write: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
        }
      }

      // Loan applications subcollection
      match /loan_applications/{appId} {
        allow read: if isSocietyMember(somitiId);
        allow create: if isSocietyMember(somitiId);
        allow update, delete: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read: if isSocietyMember(somitiId);
        allow write: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      }

      // Income subcollection
      match /income/{incomeId} {
        allow read: if isSocietyMember(somitiId);
        allow write: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      }

      // Financial accounts (Cash Drawer, Bank, Mobile Financial Services)
      match /financial_accounts/{accountId} {
        allow read: if isSocietyMember(somitiId);
        allow write: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      }

      // Financial ledger transactions
      match /financial_transactions/{txId} {
        allow read: if isSocietyMember(somitiId);
        allow create: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
        allow update, delete: if isPlatformMasterAdmin(); // Immutable for standard operators
      }

      // Notices & circulars
      match /notices/{noticeId} {
        allow read: if isSocietyMember(somitiId);
        allow write: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
      }

      // Society-level audit logs
      match /audit_logs/{logId} {
        allow read: if isSocietyAdmin(somitiId) || isPlatformMasterAdmin();
        allow create: if isAuthenticated();
        allow update, delete: if false; // Immutable audit records
      }
    }

    // Support legacy/root somiti document compatibility for web SPA
    match /somiti/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
